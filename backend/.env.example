# ============================================================
# BUNIYAAD Social Media Agent — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ── Admin credentials (simple hardcoded auth for MVP) ──────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=buniyaad2024

# ── JWT Secret (generate with: python -c "import secrets; print(secrets.token_hex(32))") ──
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# ── NVIDIA LLM API ─────────────────────────────────────────
# Get free key at: https://build.nvidia.com  →  "Get API Key"
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ── DeepSeek API ───────────────────────────────────────────
# Get key at: https://platform.deepseek.com  →  API Keys
DEEPSEEK_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Supabase ───────────────────────────────────────────────
# Create project at: https://supabase.com
# Settings → API  →  copy URL and anon key
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...

# ── Cloudinary ─────────────────────────────────────────────
# Create account at: https://cloudinary.com
# Dashboard  →  copy Cloud Name, API Key, API Secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Meta (Facebook + Instagram) API ───────────────────────
# See SETUP_GUIDE.md §META for detailed steps.
# https://developers.facebook.com
FACEBOOK_PAGE_ID=YOUR_PAGE_ID
FACEBOOK_PAGE_ACCESS_TOKEN=EAAxxxxxx...
INSTAGRAM_BUSINESS_ACCOUNT_ID=YOUR_IG_BUSINESS_ACCOUNT_ID

# ── Scheduler ─────────────────────────────────────────────
# Time (24h format, IST) to auto-generate daily post
DAILY_POST_HOUR=7
DAILY_POST_MINUTE=0

# ── App ────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
